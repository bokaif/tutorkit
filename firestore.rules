rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user gets a private document at /users/{uid}.
    // Only the owner may read, write, or delete it. Anonymous Auth
    // creates a stable uid per device, scoped per Firebase project.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 1500000;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
